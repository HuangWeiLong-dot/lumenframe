{
  // Cloudflare Workers（静态资源模式）的部署配置。
  //
  // 线上前端是 **Worker**，不是 Pages 项目 —— 控制台里那两条
  // `Deploy command: npx wrangler deploy` / `Version command: npx wrangler versions upload`
  // 就是标志。两者的关键差别：Workers 没有「Build output directory」这个输入框，
  // 产物目录只能由这份文件里的 assets.directory 指定。缺了它，`wrangler deploy`
  // 不知道要发布什么，构建会在最后一步失败。
  //
  // 构建在 Cloudflare 那边跑：根目录 web、构建命令 npm run build
  // （见 docs/deploy.md §5.3），所以下面的相对路径都是相对 web/ 而言的。

  "name": "lumenframe",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./dist",

    // "404-page"：未匹配的路径从请求路径逐级向上找最近的 404.html，以 404 状态返回。
    // 本项目的深链回退正是靠根目录那份 404.html 的 _spa= 跳转 —— 与之前在
    // GitHub Pages / Cloudflare Pages 上完全一致，**路由代码一行没改**。
    //
    // 另一条路是 "single-page-application"：未匹配路径直接以 200 返回 /index.html、
    // 不跳转，体验其实更好（少一次跳转，状态码也对）。但那样 404.html 就成了死代码，
    // 等于拆掉「404.html + index.html 内联脚本 + App.jsx 的 resolveSpaRedirect()」
    // 这个三文件契约，而它一旦出错的表现是深链无限 404 循环 —— 换一次跳转不值得。
    "not_found_handling": "404-page"
  }
}
