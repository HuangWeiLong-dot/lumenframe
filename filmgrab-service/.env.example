# 复制为 .env 后填入真实值；.env 已在 .gitignore 中忽略
# YouTube Data API v3 API Key（Google Cloud Console 启用 YouTube Data API v3）
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# 本地需要代理时由 start.ps1 / start.bat 自动探测 127.0.0.1:7890，无需手填；
# 也可手动指定：
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# Torrent-Api-py 可选访问密钥：设置后 /api/torrent/v1/* 请求必须带 X-API-Key 头；
# 留空/不设置则不鉴权。
# PYTORRENT_API_KEY=change-me
