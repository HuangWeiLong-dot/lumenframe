[Unit]
Description=LUMENFRAME backend auto deploy (git pull + restart)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# 脚本自己会 git reset --hard 它所在的工作区，而 bash 是边读边执行的：
# 直接跑仓库里那份的话，拉取到新版本时正在执行的脚本可能被写坏。
# 先复制到 /run 再执行 —— 仓库里那份始终是唯一权威版本，改了脚本随 git pull 生效。
ExecStartPre=/usr/bin/install -m 0755 /root/lumenframe/deploy/lumenframe-deploy.sh /run/lumenframe-deploy.sh
ExecStart=/bin/bash /run/lumenframe-deploy.sh

# 默认 PATH 已含 /usr/bin（npm、node、curl 都在那里）。
# 若服务器上的 node 是 nvm 装的，这里需要改成 nvm 的真实路径，例如：
# Environment=PATH=/root/.nvm/versions/node/v22.0.0/bin:/usr/local/bin:/usr/bin:/bin
